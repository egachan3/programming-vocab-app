<div class="max-w-lg mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-8">アカウント設定</h1>

  <%# メールアドレス・パスワード変更 %>
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-6">
    <div class="h-1.5 bg-rose-500"></div>
    <div class="px-6 py-6">
      <h2 class="text-base font-bold text-gray-700 mb-5">メールアドレス・パスワード変更</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                   html: { method: :put, data: { controller: "password-validation", action: "submit->password-validation#validate" } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%# クライアントサイドのパスワードエラー表示欄 %>
        <div data-password-validation-target="error"
             class="hidden mb-4 px-4 py-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-600">
        </div>

        <div class="mb-4">
          <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-rose-300 focus:border-rose-400" %>
        </div>

        <div class="mb-5">
          <%= f.label :current_password, "現在のパスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1">変更を保存するには現在のパスワードが必要です</p>
          <%= f.password_field :current_password, autocomplete: "current-password",
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-rose-300 focus:border-rose-400" %>
        </div>

        <div class="border-t border-gray-100 pt-5 mb-4">
          <%= f.label :password, "新しいパスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <p class="text-xs text-gray-400 mb-1">変更しない場合は空欄のまま
            <% if @minimum_password_length %>&nbsp;（<%= @minimum_password_length %>文字以上）<% end %>
          </p>
          <%= f.password_field :password, autocomplete: "new-password",
              data: { "password-validation-target": "password" },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-rose-300 focus:border-rose-400" %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              data: { "password-validation-target": "confirmation" },
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-rose-300 focus:border-rose-400" %>
        </div>

        <%= f.submit "変更を保存する", class: "w-full py-2.5 bg-rose-500 hover:bg-rose-600 text-white font-semibold rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <%# 退会 %>
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mb-6">
    <div class="px-6 py-5">
      <h2 class="text-base font-bold text-gray-700 mb-1">退会する</h2>
      <p class="text-sm text-gray-400 mb-4">退会するとすべての学習記録が削除されます。この操作は取り消せません。</p>
      <%= button_to "退会する", registration_path(resource_name),
          data: { turbo_confirm: "本当に退会しますか？学習記録もすべて削除されます。" },
          method: :delete,
          class: "px-5 py-2 text-sm font-medium text-red-500 border border-red-300 rounded-lg hover:bg-red-50 transition cursor-pointer bg-white" %>
    </div>
  </div>

  <%= link_to "← 戻る", :back, class: "text-sm text-gray-400 hover:text-gray-600 transition" %>
</div>
