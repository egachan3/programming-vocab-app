<% if resource.errors.any? %>
  <div id="error_explanation" class="mb-4 px-4 py-3 bg-red-50 border border-red-200 rounded-lg" data-turbo-temporary>
    <ul class="space-y-1">
      <% resource.errors.full_messages.each do |message| %>
        <li class="text-sm text-red-600"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
