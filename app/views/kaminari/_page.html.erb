<%# Link showing page number
  - available local variables
    page:          a page object for "this" page
    url:           url to this page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>
<% if page.current? %>
  <span class="px-3 py-1.5 rounded-full text-xs font-semibold bg-rose-500 text-white border border-rose-500"><%= page %></span>
<% else %>
  <%= link_to page, url, { remote: remote, rel: page.rel, class: "px-3 py-1.5 rounded-full text-xs font-medium border border-gray-300 text-gray-600 hover:border-rose-400 transition" } %>
<% end %>
