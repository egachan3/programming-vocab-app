<div class="flex flex-col items-center text-center">
  <h1 class="text-3xl sm:text-4xl font-bold text-gray-800 mb-3">学習を始めよう</h1>
  <p class="text-gray-500 text-sm sm:text-base mb-10 sm:mb-12">カテゴリを選んで単語学習をスタート</p>

  <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 w-full sm:w-auto items-center">
    <% @large_categories.each do |large_category| %>
      <% icon_file = case large_category.name
                     when "Ruby"  then "Ruby_icon.png"
                     when "Rails" then "Rails_icon.png"
                     else nil
                     end %>
      <%= link_to large_category_levels_path(large_category),
                  class: "group relative w-full sm:w-56 h-44 sm:h-56 flex flex-col items-center justify-center rounded-2xl border border-gray-200 shadow-sm hover:shadow-lg hover:border-rose-300 hover:-translate-y-1 transition-all duration-200 cursor-pointer bg-white overflow-hidden px-4" do %>
        <%# 上部の差し色アクセント %>
        <span class="absolute top-0 inset-x-0 h-1.5 bg-rose-500"></span>

        <% if icon_file %>
          <%= image_tag icon_file, class: "w-16 sm:w-20 h-16 sm:h-20 object-contain mb-3 sm:mb-4", alt: large_category.name %>
        <% end %>
        <span class="text-base sm:text-lg font-bold text-gray-800"><%= large_category.name %></span>
        <span class="mt-2 text-xs font-medium text-rose-500 opacity-0 group-hover:opacity-100 transition">学習を始める →</span>
      <% end %>
    <% end %>
  </div>
</div>
