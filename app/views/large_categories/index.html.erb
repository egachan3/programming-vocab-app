<div class="flex flex-col items-center text-center">
  <h1 class="text-2xl sm:text-3xl font-bold mb-2">カテゴリを選択してください</h1>
  <p class="text-gray-500 text-sm sm:text-base mb-8 sm:mb-10">学習したいカテゴリを選んでスタート！</p>

  <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 w-full sm:w-auto items-center">
    <% @large_categories.each do |large_category| %>
      <%= link_to large_category_levels_path(large_category),
                  class: "w-full sm:w-48 h-32 sm:h-48 flex flex-col items-center justify-center rounded-2xl border-2 border-gray-200 shadow hover:shadow-md hover:border-blue-400 transition cursor-pointer bg-white" do %>
        <span class="text-4xl sm:text-5xl mb-2 sm:mb-3">📚</span>
        <span class="text-lg sm:text-xl font-semibold"><%= large_category.name %></span>
      <% end %>
    <% end %>
  </div>
</div>
