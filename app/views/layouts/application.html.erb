<!DOCTYPE html>
<html>
  <head>
    <% og_title = content_for(:title) || "Programming Vocab App" %>
    <% og_description = "Ruby / Rails 初学者向けの、プログラミング用語をカテゴリ・レベル別に整理して学べる単語帳アプリ" %>
    <% og_image_url = "#{request.base_url}/ogp.png" %>
    <%# クエリパラメータ(トラッキング用など)を含めず、正規URLとして扱えるパスのみを渡す %>
    <% og_url = "#{request.base_url}#{request.path}" %>

    <title><%= og_title %></title>
    <meta name="description" content="<%= og_description %>">
    <link rel="canonical" href="<%= og_url %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Programming Vocab App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# OGP: SlackやX、LINEなどにURLを貼った際にカード表示されるようにする %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Programming Vocab App">
    <meta property="og:locale" content="ja_JP">
    <meta property="og:title" content="<%= og_title %>">
    <meta property="og:description" content="<%= og_description %>">
    <meta property="og:url" content="<%= og_url %>">
    <meta property="og:image" content="<%= og_image_url %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= og_title %>">
    <meta name="twitter:description" content="<%= og_description %>">
    <meta name="twitter:image" content="<%= og_image_url %>">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen flex flex-col">
    <%# 共通ヘッダー %>
    <% if user_signed_in? %>
      <header class="bg-red-500 sticky top-0 z-10 shadow-sm">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
          <%= link_to root_path, class: "flex items-center gap-2" do %>
            <%= image_tag "service_logo.png", class: "h-6 w-auto object-contain", alt: "Programming Vocab" %>
            <span class="font-bold text-white hidden sm:inline">Programming Vocab</span>
          <% end %>
          <nav class="flex items-center gap-3 sm:gap-4 text-sm">
            <%= link_to "学習履歴", learning_records_path, class: "text-white hover:text-rose-100 transition" %>
            <%= link_to "設定", edit_user_registration_path, class: "text-white hover:text-rose-100 transition" %>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                          class: "text-white hover:text-rose-100 transition bg-transparent border-0 cursor-pointer p-0" %>
          </nav>
        </div>
      </header>
    <% end %>

    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-10">
      <% if notice %>
        <div data-controller="flash" class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div data-controller="flash" class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-600 text-sm rounded-xl"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="border-t border-gray-200 bg-white mt-auto">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-center gap-6 text-xs text-gray-400">
        <%= link_to "利用規約", terms_path, class: "hover:text-rose-500 transition" %>
        <%= link_to "プライバシーポリシー", privacy_path, class: "hover:text-rose-500 transition" %>
        <%= link_to "お問い合わせ", "https://forms.gle/dN1yKaLNXQcWkgZJA", target: "_blank", rel: "noopener noreferrer", class: "hover:text-rose-500 transition" %>
      </div>
    </footer>
  </body>
</html>
