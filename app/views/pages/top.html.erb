<%# ヒーローセクション %>
<div class="-mx-4 sm:-mx-6 -mt-6 sm:-mt-10 bg-gradient-to-br from-rose-500 to-rose-600 px-4 sm:px-6 py-16 sm:py-24 text-center">
  <%= image_tag "service_logo.png", class: "h-16 w-auto mx-auto mb-6", alt: "Programming Vocab" %>
  <h1 class="text-3xl sm:text-5xl font-bold text-white mb-4">Programming Vocab</h1>
  <p class="text-rose-100 text-base sm:text-xl mb-10">Ruby の基礎単語を、確実に覚える</p>

  <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
    <%= button_to "ゲストとしてログイン", guest_login_path,
                  method: :post,
                  class: "w-full sm:w-auto px-8 py-3 bg-white text-rose-500 hover:bg-rose-50 font-bold rounded-full shadow-md transition cursor-pointer" %>
    <%= link_to "アカウント作成", new_user_registration_path,
                class: "w-full sm:w-auto px-8 py-3 border-2 border-white text-white hover:bg-white hover:text-rose-500 font-bold rounded-full transition text-center" %>
    <%= link_to "ログイン", new_user_session_path,
                class: "w-full sm:w-auto px-8 py-3 text-rose-100 hover:text-white font-medium transition text-center" %>
  </div>
</div>

<%# 機能紹介セクション: 説明とスクリーンショットを左右交互に配置する %>
<div class="py-16 sm:py-24 space-y-16 sm:space-y-24">
  <%# 単語学習 %>
  <div class="flex flex-col sm:flex-row items-center gap-8 sm:gap-12">
    <div class="flex-1">
      <div class="inline-flex items-center gap-2 text-rose-500 text-sm font-semibold mb-3">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
        </svg>
        単語学習
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-gray-800 mb-3">カテゴリとレベル別に、迷わず学べる</h3>
      <p class="text-gray-500 text-sm sm:text-base leading-relaxed">
        Ruby / Rails の基礎単語を、カテゴリと3段階のレベルに整理しています。
        単語の説明に加えてコード例も確認できるので、実際の書き方とセットで覚えられます。
      </p>
    </div>
    <div class="flex-1 w-full rounded-2xl overflow-hidden border border-gray-200 shadow-md">
      <%# TODO: 単語一覧画面のスクリーンショットに差し替える %>
      <%= image_tag "LP_imag.png", class: "w-full h-auto object-cover", alt: "単語一覧画面" %>
    </div>
  </div>

  <%# テスト機能 %>
  <div class="flex flex-col sm:flex-row-reverse items-center gap-8 sm:gap-12">
    <div class="flex-1">
      <div class="inline-flex items-center gap-2 text-rose-500 text-sm font-semibold mb-3">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        テスト機能
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-gray-800 mb-3">単語帳形式で、記憶を定着させる</h3>
      <p class="text-gray-500 text-sm sm:text-base leading-relaxed">
        カードをタップして答えを確認し、「覚えた」「覚えていない」を記録します。
        1問ずつ進む形式なので、通勤時間などのすきま時間でも学習を進められます。
      </p>
    </div>
    <div class="flex-1 w-full rounded-2xl overflow-hidden border border-gray-200 shadow-md">
      <%# TODO: テスト画面のスクリーンショットに差し替える %>
      <%= image_tag "LP_imag.png", class: "w-full h-auto object-cover", alt: "テスト画面" %>
    </div>
  </div>

  <%# 学習履歴 %>
  <div class="flex flex-col sm:flex-row items-center gap-8 sm:gap-12">
    <div class="flex-1">
      <div class="inline-flex items-center gap-2 text-rose-500 text-sm font-semibold mb-3">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
        </svg>
        学習履歴
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-gray-800 mb-3">どこまで覚えたかが、ひと目でわかる</h3>
      <p class="text-gray-500 text-sm sm:text-base leading-relaxed">
        学習した単語は「覚えた」「覚えていない」で絞り込んで確認できます。
        レベル選択画面には進捗バーが表示されるので、どこまで進んだかを把握しながら続けられます。
      </p>
    </div>
    <div class="flex-1 w-full rounded-2xl overflow-hidden border border-gray-200 shadow-md">
      <%# TODO: 学習履歴画面のスクリーンショットに差し替える %>
      <%= image_tag "LP_imag.png", class: "w-full h-auto object-cover", alt: "学習履歴画面" %>
    </div>
  </div>
</div>

<%# 使い方セクション %>
<div class="py-16 sm:py-20 border-t border-gray-100">
  <h2 class="text-xl sm:text-2xl font-bold text-center text-gray-800 mb-12">使い方</h2>

  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-0">
    <div class="flex-1 text-center px-4">
      <div class="w-12 h-12 border-2 border-rose-500 text-rose-500 font-bold text-lg rounded-full flex items-center justify-center mx-auto mb-4">1</div>
      <h3 class="font-bold text-gray-800 mb-2">カテゴリを選ぶ</h3>
      <p class="text-gray-500 text-sm">学習したいカテゴリとレベルを選択します</p>
    </div>

    <div class="hidden sm:flex items-center pb-8 text-rose-300 text-3xl font-light">→</div>
    <div class="sm:hidden text-rose-300 text-3xl">↓</div>

    <div class="flex-1 text-center px-4">
      <div class="w-12 h-12 border-2 border-rose-500 text-rose-500 font-bold text-lg rounded-full flex items-center justify-center mx-auto mb-4">2</div>
      <h3 class="font-bold text-gray-800 mb-2">単語を学習する</h3>
      <p class="text-gray-500 text-sm">単語の意味や使い方をじっくり確認します</p>
    </div>

    <div class="hidden sm:flex items-center pb-8 text-rose-300 text-3xl font-light">→</div>
    <div class="sm:hidden text-rose-300 text-3xl">↓</div>

    <div class="flex-1 text-center px-4">
      <div class="w-12 h-12 border-2 border-rose-500 text-rose-500 font-bold text-lg rounded-full flex items-center justify-center mx-auto mb-4">3</div>
      <h3 class="font-bold text-gray-800 mb-2">テストで確認する</h3>
      <p class="text-gray-500 text-sm">覚えた単語をテストして記録に残します</p>
    </div>
  </div>
</div>

<%# 最下部CTAセクション %>
<div class="-mx-4 sm:-mx-6 -mb-6 sm:-mb-10 bg-rose-50 px-4 sm:px-6 py-14 sm:py-20 text-center">
  <h2 class="text-xl sm:text-2xl font-bold text-gray-800 mb-3">さっそく始めてみよう</h2>
  <p class="text-gray-500 text-sm mb-8">登録不要でゲストとして試すことができます</p>
  <%= button_to "ゲストとしてログイン", guest_login_path,
                method: :post,
                class: "px-10 py-3 bg-rose-500 hover:bg-rose-600 text-white font-bold rounded-full shadow-md transition cursor-pointer" %>
</div>
