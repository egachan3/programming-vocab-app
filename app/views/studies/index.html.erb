<div class="max-w-2xl mx-auto" data-controller="study">
  <%# ヘッダー %>
  <div class="mb-4 sm:mb-6 flex items-center justify-between">
    <div>
      <p class="text-gray-400 text-xs sm:text-sm"><%= @large_category.name %> / Lv<%= @level %></p>
      <h1 class="text-xl sm:text-2xl font-bold">テスト</h1>
    </div>
    <p class="text-gray-500 text-sm">
      <span data-study-target="current">1</span> / <span data-study-target="total"><%= @words.size %></span>
    </p>
  </div>

  <%# 中断して戻るリンク %>
  <div class="mb-4">
    <%= link_to "← 戻る", large_category_levels_path(@large_category),
                class: "text-gray-500 hover:text-gray-700 text-sm" %>
  </div>

  <% if @words.any? %>
    <%# カード一覧（CSSで初期状態は非表示、is-active が付いたカードのみ表示） %>
    <% @words.each_with_index do |word, index| %>
      <div data-study-target="card"
           data-action="click->study#flip"
           data-word-id="<%= word.id %>"
           class="study-card <%= 'is-active' if index.zero? %> cursor-pointer bg-white border border-gray-200 rounded-2xl shadow-sm p-6 sm:p-10 flex-col items-center justify-center text-center"
           style="min-height: 14rem;">
        <%# 表面 %>
        <div class="card-front">
          <p class="text-gray-400 text-xs mb-3">タップで答えを表示</p>
          <p class="text-2xl sm:text-3xl font-bold break-words"><%= word.term %></p>
        </div>
        <%# 裏面 %>
        <div class="card-back">
          <p class="text-gray-400 text-xs mb-3"><%= word.term %></p>
          <p class="text-gray-800 whitespace-pre-line leading-relaxed text-sm sm:text-base"><%= word.description %></p>
        </div>
      </div>
    <% end %>

    <%# 操作ボタン %>
    <div class="mt-6 flex gap-4">
      <button data-action="click->study#remember"
              data-remembered="false"
              class="flex-1 bg-red-100 text-red-600 font-semibold py-3 rounded-xl hover:bg-red-200 transition">
        覚えていない
      </button>
      <button data-action="click->study#remember"
              data-remembered="true"
              class="flex-1 bg-green-100 text-green-600 font-semibold py-3 rounded-xl hover:bg-green-200 transition">
        覚えた
      </button>
    </div>

    <%# 完了画面 %>
    <div data-study-target="completion" class="completion-area mt-8 text-center bg-white border border-gray-200 rounded-2xl p-10">
      <p class="text-2xl font-bold mb-2">お疲れさまでした！</p>
      <p class="text-gray-500 mb-6">すべての単語を学習しました</p>
      <%= link_to "レベル選択に戻る", large_category_levels_path(@large_category),
                  class: "inline-block bg-blue-500 text-white font-semibold px-6 py-2 rounded-xl hover:bg-blue-600 transition" %>
    </div>
  <% else %>
    <p class="text-gray-400 text-center mt-10">このレベルの単語がありません</p>
  <% end %>
</div>

<%# テスト画面用CSS %>
<style>
  .study-card { display: none; }
  .study-card.is-active { display: flex; }
  .study-card .card-back { display: none; }
  .study-card.is-flipped .card-front { display: none; }
  .study-card.is-flipped .card-back { display: block; }
  .completion-area { display: none; }
  .completion-area.is-visible { display: block; }
</style>
