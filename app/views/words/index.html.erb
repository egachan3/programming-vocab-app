<div class="max-w-3xl mx-auto pb-24">
  <div class="mb-4 sm:mb-6">
    <p class="text-gray-400 text-xs sm:text-sm mb-1">
      <%= link_to @large_category.name, large_category_levels_path(@large_category), class: "hover:underline" %> &gt; Lv<%= @level %>
    </p>
    <h1 class="text-xl sm:text-2xl font-bold">単語一覧</h1>
  </div>

  <%# 検索フォーム %>
  <%= form_with url: search_words_path, method: :get, local: true do |f| %>
    <div class="flex gap-2 mb-6">
      <%= f.text_field :q, name: "q[term_cont]",
                       placeholder: "単語を検索...",
                       class: "flex-1 border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-rose-400" %>
      <%= f.submit "検索", class: "bg-rose-500 text-white px-4 py-2 rounded-xl text-sm hover:bg-rose-600 transition cursor-pointer" %>
    </div>
  <% end %>

  <%# 中カテゴリ横スクロールタブ %>
  <div class="relative mb-6" data-controller="category-scroll">
    <%# 左矢印（左端では非表示） %>
    <button type="button"
            data-action="click->category-scroll#scrollToLeft"
            data-category-scroll-target="leftArrow"
            aria-label="左へスクロール"
            class="hidden absolute left-0 top-1/2 -translate-y-1/2 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white shadow-md border border-gray-200 text-gray-500 hover:text-rose-500 hover:border-rose-300 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <%# スクロールコンテナ %>
    <div class="category-scroller relative flex gap-2 overflow-x-auto pb-2"
         data-category-scroll-target="scroller"
         data-action="scroll->category-scroll#update">
      <% @categories.each do |category| %>
        <%= link_to words_path(large_category_id: @large_category.id, level: @level, category_id: category.id),
                    data: { "category-active": (category == @current_category).to_s },
                    class: "whitespace-nowrap px-4 py-2 rounded-full border text-sm font-medium transition #{ category == @current_category ? 'bg-rose-500 text-white border-rose-500' : 'bg-white text-gray-600 border-gray-300 hover:border-rose-400' }" do %>
          <%= category.name %>
        <% end %>
      <% end %>
    </div>

    <%# 右矢印（右端では非表示） %>
    <button type="button"
            data-action="click->category-scroll#scrollToRight"
            data-category-scroll-target="rightArrow"
            aria-label="右へスクロール"
            class="hidden absolute right-0 top-1/2 -translate-y-1/2 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white shadow-md border border-gray-200 text-gray-500 hover:text-rose-500 hover:border-rose-300 transition">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>

  <%# カテゴリタブのスクロールバーを非表示にする（矢印で操作するため） %>
  <style>
    .category-scroller { scrollbar-width: none; }
    .category-scroller::-webkit-scrollbar { display: none; }
  </style>

  <%# 単語一覧 %>
  <% if @words.any? %>
    <div class="flex flex-col gap-3">
      <% @words.each do |word| %>
        <%= link_to word_path(word), class: "block bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md hover:border-rose-300 transition" do %>
          <p class="font-semibold text-lg"><%= word.term %></p>
          <p class="text-gray-500 text-sm mt-1 line-clamp-2"><%= word.description %></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-400 text-center mt-10">このカテゴリにLv<%= @level %>の単語はありません</p>
  <% end %>

  <%# テスト開始ボタン（画面下部固定） %>
  <div class="fixed bottom-6 inset-x-0 z-50 flex justify-center pointer-events-none">
    <%= link_to "テスト開始", studies_path(large_category_id: @large_category.id, level: @level),
                class: "pointer-events-auto bg-rose-500 text-white font-semibold px-10 py-3 rounded-full shadow-lg hover:bg-rose-600 transition" %>
  </div>
</div>
