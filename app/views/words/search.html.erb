<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold">単語検索</h1>
  </div>

  <%# 検索フォーム %>
  <%= form_with url: search_words_path, method: :get, local: true do |f| %>
    <div class="flex gap-2 mb-6">
      <%= f.text_field :q, name: "q[term_cont]",
                       value: params.dig(:q, :term_or_description_cont),
                       placeholder: "単語を検索...",
                       class: "flex-1 border border-gray-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-blue-400" %>
      <%= f.submit "検索", class: "bg-blue-500 text-white px-4 py-2 rounded-xl text-sm hover:bg-blue-600 transition cursor-pointer" %>
    </div>
  <% end %>

  <%# 検索結果 %>
  <% if @words.any? %>
    <p class="text-gray-400 text-sm mb-4"><%= @words.size %>件見つかりました</p>
    <div class="flex flex-col gap-3">
      <% @words.each do |word| %>
        <%= link_to word_path(word), class: "block bg-white border border-gray-200 rounded-xl p-4 hover:shadow-md hover:border-blue-300 transition" do %>
          <div class="flex items-center justify-between mb-1">
            <p class="font-semibold text-lg"><%= word.term %></p>
            <div class="flex gap-2">
              <span class="text-xs bg-gray-100 text-gray-500 px-2 py-1 rounded"><%= word.category.name %></span>
              <span class="text-xs bg-blue-100 text-blue-500 px-2 py-1 rounded">Lv<%= word.level %></span>
            </div>
          </div>
          <p class="text-gray-500 text-sm line-clamp-2"><%= word.description %></p>
        <% end %>
      <% end %>
    </div>
  <% elsif params[:q]&.dig(:term_or_description_cont).present? %>
    <p class="text-gray-400 text-center mt-10">「<%= params[:q][:term_or_description_cont] %>」に一致する単語が見つかりませんでした</p>
  <% end %>

  <div class="mt-8">
    <%= link_to "← トップに戻る", root_path, class: "text-gray-400 hover:text-gray-600 text-sm" %>
  </div>
</div>
