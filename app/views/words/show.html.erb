<div class="max-w-3xl mx-auto">
  <%# パンくず %>
  <div class="mb-6">
    <p class="text-gray-400 text-sm mb-1">
      <%= link_to @large_category.name, large_category_levels_path(@large_category), class: "hover:underline" %>
      &gt;
      <%= link_to "Lv#{@word.level}", words_path(large_category_id: @large_category.id, level: @word.level, category_id: @category.id), class: "hover:underline" %>
      &gt;
      <%= @category.name %>
    </p>
  </div>

  <%# 単語詳細カード %>
  <div class="bg-white border border-gray-200 rounded-2xl p-5 sm:p-8 shadow-sm">
    <div class="flex items-center flex-wrap gap-2 sm:gap-3 mb-4">
      <span class="text-xs font-semibold bg-blue-100 text-blue-600 px-2 py-1 rounded">Lv<%= @word.level %></span>
      <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-2 py-1 rounded"><%= @category.name %></span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-bold mb-4 sm:mb-6 break-words"><%= @word.term %></h1>

    <div class="mb-6">
      <h2 class="text-xs sm:text-sm font-semibold text-gray-500 mb-2">説明</h2>
      <p class="text-gray-800 whitespace-pre-line leading-relaxed text-sm sm:text-base"><%= @word.description %></p>
    </div>

    <% if @word.code_example.present? %>
      <div>
        <h2 class="text-xs sm:text-sm font-semibold text-gray-500 mb-2">コード例</h2>
        <pre class="bg-gray-900 text-green-200 text-xs sm:text-sm rounded-lg p-3 sm:p-4 overflow-x-auto"><code><%= @word.code_example %></code></pre>
      </div>
    <% end %>
  </div>

  <%# 戻るボタン %>
  <div class="mt-6">
    <%= link_to "← 一覧に戻る", words_path(large_category_id: @large_category.id, level: @word.level, category_id: @category.id), class: "text-gray-500 hover:text-gray-700 text-sm" %>
  </div>
</div>
